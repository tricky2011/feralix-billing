APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_SEED_SAMPLE_DATA=false
APP_SUPERADMIN_NAME=Superadmin
APP_SUPERADMIN_USERNAME=arya
APP_SUPERADMIN_EMAIL=
APP_SUPERADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
AUTOMATION_LOG_CHANNEL=automation
AUTOMATION_LOG_LEVEL=debug

# RADIUS Internal API Configuration
# REQUIRED: You must set a secret value to enable RADIUS hotspot authentication.
# Without this secret configured, internal RADIUS endpoints will be rejected.
HOTSPOT_RADIUS_PROVIDER=stub
HOTSPOT_RADIUS_INTERNAL_SECRET=
HOTSPOT_RADIUS_EXPIRED_REDIRECT_URL=

# Database utama aplikasi.
# Gunakan `mysql` untuk MySQL 8+ atau `mariadb` untuk MariaDB 10.6+.
# Ganti database, username, dan password sesuai server Anda.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=feralix_billing
DB_USERNAME=feralix_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SANCTUM_TOKEN_EXPIRATION=10080
# Aktifkan opsi di bawah ini hanya jika server Anda memerlukannya.
# DB_SOCKET=/run/mysqld/mysqld.sock
# DB_TIMEOUT=5
# DB_ENGINE=InnoDB
# MYSQL_ATTR_SSL_CA=/path/to/mysql-ca.pem

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
AUTOMATION_QUEUE_BILLING=billing
AUTOMATION_QUEUE_PROVISIONING=provisioning
AUTOMATION_QUEUE_NETWORK=network
AUTOMATION_QUEUE_MONITORING=monitoring
AUTOMATION_QUEUE_NOTIFICATIONS=notifications

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

AUTOMATION_SCHEDULE_TIMEZONE=UTC
AUTOMATION_SCHEDULE_GENERATE_INVOICES_AT=00:05
AUTOMATION_SCHEDULE_CHECK_OVERDUE_AT=00:20
AUTOMATION_SCHEDULE_CREATE_OVERDUE_ISOLATIONS_AT=00:30
AUTOMATION_SCHEDULE_SYNC_MIKROTIK_VID_CRON="*/15 * * * *"
AUTOMATION_SCHEDULE_SYNC_PPPOE_CRON="* * * * *"
AUTOMATION_SCHEDULE_SYNC_GENIEACS_CRON="*/5 * * * *"
AUTOMATION_SCHEDULE_PROCESS_TELEGRAM_CRON="* * * * *"

BILLING_MONTHLY_INVOICE_DUE_IN_DAYS=10
BILLING_MONTHLY_INVOICE_PENALTY_AMOUNT=0
BILLING_OVERDUE_SYNC_CHUNK=200
BILLING_OVERDUE_ISOLATION_CHUNK=100
BILLING_OVERDUE_ISOLATION_NOTES="Generated automatically from overdue invoice scheduler."
TELEGRAM_PROCESS_BATCH_LIMIT=100

MIKROTIK_SYNC_PROVIDER=fake
MIKROTIK_LOG_CHANNEL=automation
MIKROTIK_ISOLATION_ADDRESS_LIST_NAME=ISOLIR_CUSTOMER
MIKROTIK_API_CONNECT_TIMEOUT=5
MIKROTIK_API_READ_TIMEOUT=15
# MIKROTIK_API_SSL_ENABLED=true
# MIKROTIK_API_SSL_VERIFY_PEER=true
# MIKROTIK_API_SSL_VERIFY_PEER_NAME=true
# MIKROTIK_API_SSL_ALLOW_SELF_SIGNED=false
# MIKROTIK_API_SSL_CAFILE=/path/to/ca.pem
# MIKROTIK_API_SSL_PEER_NAME=router.example.internal

GENIEACS_SYNC_PROVIDER=fake
GENIEACS_LOG_CHANNEL=automation
GENIEACS_HTTP_TIMEOUT=15
GENIEACS_HTTP_CONNECT_TIMEOUT=5

TELEGRAM_LOG_CHANNEL=automation
TELEGRAM_HELPDESK_GROUP_NAME=helpdesk

VITE_APP_NAME="${APP_NAME}"
